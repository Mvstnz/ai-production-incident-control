        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response=$json; const status=Number(response.statusCode); const raw=response.headers?.['retry-after']; const seconds=raw==null?null:Number(raw); return [{json:{...$('Impact Context').first().json,error_class:status===429||status>=500?'TRANSIENT':'PERMANENT',retry_after:Number.isFinite(seconds)?seconds:null,message:'ERP snapshot HTTP '+status}}];"
      }
