          "conditions": [
            {
              "id": "556da52b-1faa-5c2f-8ba8-8f00abd69ab1",
              "leftValue": "={{ $json.status==='PENDING' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
