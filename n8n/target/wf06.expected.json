        "incomingAuthentication": "headerAuth",
        "responseMode": "onReceived",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 30,
        "resumeUnit": "seconds",
        "options": {
          "noResponseBody": true
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "APIC Webhook Intake"
        }
      }
    },
