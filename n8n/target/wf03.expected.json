        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {job_id:$json.job_id,owner:'n8n:'+$execution.id,limit:1,execution_id:$execution.id,workflow_id:$workflow.id} }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "APIC Operations Service"
        }
      }
    },
