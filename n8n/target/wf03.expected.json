      "parameters": {
        "content": "## WF03 · Normalize Verify and Correlate\nClaim due job → extract supported fixture or structured facts → verify ERP identity → correlate immutable revision. Unknown input requires manual review.\n\nSynthetic data · simulated AI · local sandbox only.",
        "height": 190,
        "width": 700
      }
    },
    {
      "name": "Workflow Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
