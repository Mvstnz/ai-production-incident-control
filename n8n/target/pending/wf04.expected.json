{
  "key": "wf04",
  "name": "APIC | WF04 | ERP Impact Analysis",
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "KF1ttQVhDbDHBDmY"
  },
  "nodes": [
    {
      "name": "Purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -270
      ],
      "parameters": {
        "content": "## WF04 · ERP Impact Analysis\nRead one immutable ERP snapshot → pure baseline/incident allocation → persist evidence. No formula duplication in n8n.\n\nSynthetic data · simulated AI · local sandbox only.",
        "height": 190,
        "width": 700
      }
    },
    {
      "name": "Workflow Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        270,
        200
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "name": "Impact Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map(i=>({json:{...i.json,execution_id:$execution.id,workflow_id:$workflow.id}}));"
      }
    },
    {
      "name": "Read Immutable ERP Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        810,
        200
      ],
      "parameters": {
        "url": "={{ 'https://configure-apic-erp.invalid/erp/v1/snapshots/'+$json.snapshot_id+'?scope_id='+$json.scope_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "APIC ERP Read"
        }
      }
    },
    {
      "name": "ERP Snapshot Read Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1080,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "7091eadc-2d9f-5972-af44-28cc05078269",
              "leftValue": "={{ $json.statusCode>=200 && $json.statusCode<300 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Calculate Temporal Impact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1350,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://configure-apic-ops.invalid/internal/impact/evaluate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {snapshot:$json.body,facts:$('Impact Context').first().json.facts} }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "APIC Operations Service"
        }
      }
    },
    {
      "name": "Persist Impact Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1620,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://configure-apic-ops.invalid/internal/impact/save",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {...$('Impact Context').first().json,impact:$json} }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "APIC Operations Service"
        }
      }
    },
    {
      "name": "Preserve ERP Retry Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1890,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response=$json; const status=Number(response.statusCode); const raw=response.headers?.['retry-after']; const seconds=raw==null?null:Number(raw); return [{json:{...$('Impact Context').first().json,error_class:status===429||status>=500?'TRANSIENT':'PERMANENT',retry_after:Number.isFinite(seconds)?seconds:null,message:'ERP snapshot HTTP '+status}}];"
      }
    },
    {
      "name": "Persist Failed Snapshot Read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2160,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://configure-apic-ops.invalid/internal/jobs/fail",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "APIC Operations Service"
        }
      }
    },
    {
      "name": "Stop Failed Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2430,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "throw new Error('ERP snapshot read failed; retry metadata durably recorded');"
      }
    },
    {
      "name": "Target Configuration BLOCKED",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -720
      ],
      "parameters": {
        "content": "## BLOCKED — inactive / unpublished\nConfigure authorized Operations and ERP HTTPS endpoints and missing APIC credentials before any separately authorized execution.\n\nhttps://configure-apic-ops.invalid and https://configure-apic-erp.invalid are deliberately non-routable configuration placeholders. Preserve every endpoint path. Dynamic wakeup URLs must be backend-validated for the authorized n8n host and protected by APIC Webhook Intake.\n\nWorkflow settings (Asia/Bangkok, caller policy, retention and shared WF09 error routing) are pending: no documented SDK creation settings; update is blocked by the approval gate. WF09 must remain unpublished. No runtime test has run.",
        "width": 980,
        "height": 390,
        "color": 3
      }
    }
  ],
  "connections": {
    "Workflow Input": {
      "main": [
        [
          {
            "node": "Impact Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Impact Context": {
      "main": [
        [
          {
            "node": "Read Immutable ERP Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Immutable ERP Snapshot": {
      "main": [
        [
          {
            "node": "ERP Snapshot Read Succeeded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ERP Snapshot Read Succeeded": {
      "main": [
        [
          {
            "node": "Calculate Temporal Impact",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Preserve ERP Retry Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Temporal Impact": {
      "main": [
        [
          {
            "node": "Persist Impact Evidence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preserve ERP Retry Metadata": {
      "main": [
        [
          {
            "node": "Persist Failed Snapshot Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Failed Snapshot Read": {
      "main": [
        [
          {
            "node": "Stop Failed Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
